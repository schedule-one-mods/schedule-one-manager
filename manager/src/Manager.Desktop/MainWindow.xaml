<Window x:Class="ScheduleI.Manager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule I Mod Manager" Width="1160" Height="820" MinWidth="960" MinHeight="700" Background="#101820" Foreground="#EEF4F7" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#293B49"/><Setter Property="Foreground" Value="#EEF4F7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#77D6B7"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton" x:Key="Navigation">
            <Setter Property="Foreground" Value="#A9BBC8"/><Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="GroupName" Value="Navigation"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#213B3C"/><Setter Property="Foreground" Value="#95E6CA"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#23313D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#77D6B7"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#101820"/><Setter Property="Foreground" Value="#EEF4F7"/><Setter Property="BorderBrush" Value="#354958"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="Background" Value="#19252F"/><Setter Property="Foreground" Value="#EEF4F7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="MinRowHeight" Value="64"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1E2D38"/><Setter Property="Foreground" Value="#9BB0C0"/><Setter Property="Padding" Value="16,12"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="#19252F"/><Setter Property="Foreground" Value="#EEF4F7"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#263D4B"/></Trigger></Style.Triggers></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#19252F"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#141F28" BorderBrush="#263440" BorderThickness="0,0,1,0" Padding="18,28,18,20"><DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="10,0,0,34"><TextBlock Text="SCHEDULE I" FontSize="11" FontWeight="Bold" Foreground="#83DDBE"/><TextBlock Text="Mod Manager" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0"><TextBlock Text="COMMUNITY EDITION" FontSize="10" Foreground="#7F96A8"/><TextBlock x:Name="VersionLabel" Margin="0,7,0,0" Foreground="#A9BBC8" FontSize="12"/></StackPanel>
            <StackPanel><RadioButton x:Name="MyModsNav" Content="My mods" Tag="MyMods" Style="{StaticResource Navigation}" Checked="Navigate"/><RadioButton x:Name="BrowseNav" Content="Browse mods" Tag="Browse" Style="{StaticResource Navigation}" Checked="Navigate"/><RadioButton x:Name="SettingsNav" Content="Settings" Tag="Settings" Style="{StaticResource Navigation}" Checked="Navigate"/></StackPanel>
        </DockPanel></Border>
        <Grid Grid.Column="1" Margin="30,26,30,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,22"><StackPanel Margin="0,0,170,0"><TextBlock x:Name="PageTitle" Text="My mods" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="Choose what comes with you on your next session." Foreground="#A9BBC8" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1E2D38" CornerRadius="16" Padding="12,7"><TextBlock x:Name="LaunchState" Text="Checking setup" Foreground="#95E6CA" FontSize="12"/></Border></Grid>
            <StackPanel Grid.Row="1">
                <Border x:Name="CriticalBanner" Visibility="Collapsed" Background="#40272A" BorderBrush="#B86B68" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16"><DockPanel><Button DockPanel.Dock="Right" Content="Review settings" Click="ShowSettings" Margin="16,0,0,0" VerticalAlignment="Center" Background="#68403F"/><StackPanel><TextBlock Text="Action needed before playing" FontWeight="SemiBold" Foreground="#FFD3C9"/><TextBlock x:Name="CriticalMessage" TextWrapping="Wrap" Foreground="#F0BDB5" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
                <Border x:Name="RegistryBanner" Visibility="Collapsed" Background="#3B3322" CornerRadius="8" Padding="16" Margin="0,0,0,16"><TextBlock x:Name="RegistryNotice" TextWrapping="Wrap" Foreground="#F2D39B"/></Border>
                <Border x:Name="ModWarningsBanner" Visibility="Collapsed" Background="#3B3322" CornerRadius="8" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="Some mods cannot be enabled" Foreground="#FFE1AB" FontWeight="SemiBold"/><TextBlock x:Name="ModWarningsMessage" TextWrapping="Wrap" Foreground="#F2D39B" Margin="0,6,0,0"/></StackPanel></Border>
            </StackPanel>
            <Grid x:Name="ControlsPanel" Grid.Row="2">
                <Grid x:Name="MyModsPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh" Margin="14,0,0,0"/><StackPanel><TextBlock Text="YOUR LIBRARY" FontSize="11" FontWeight="SemiBold" Foreground="#83DDBE"/><TextBlock x:Name="LibrarySummary" Margin="0,7,0,0" Foreground="#A9BBC8" TextWrapping="Wrap"/></StackPanel></DockPanel>
                    <Grid Grid.Row="1"><Border Background="#19252F" CornerRadius="10" ClipToBounds="True"><DataGrid x:Name="ModGrid"><DataGrid.Columns>
                        <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="1.1*"/><DataGridTemplateColumn Header="Version" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" AutomationProperties.Name="Select mod version" MinWidth="130"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.9*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Action}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToggleReason}" ToolTipService.ShowOnDisabled="True" Tag="{Binding Package}" Click="ToggleMod" Padding="12,8" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Delete downloads" Width="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><Button Content="Delete version" Tag="{Binding}" Click="DeleteVersion" Padding="8,5" Margin="0,0,0,3"/><Button Content="Delete whole mod" Tag="{Binding}" Click="DeleteMod" Padding="8,5" Margin="0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns></DataGrid></Border><StackPanel x:Name="EmptyLibrary" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Your next session starts here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Browse the community registry to add your first mod." Foreground="#A9BBC8" Margin="0,10,0,20"/><Button Content="Browse mods" Click="ShowBrowse" HorizontalAlignment="Center" Background="#286B59"/></StackPanel></Grid>
                </Grid>
                <Grid x:Name="BrowsePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16"><Button x:Name="RegistryRefreshButton" DockPanel.Dock="Right" Content="Refresh registry" Click="RefreshRegistry" Margin="14,0,0,0"/><Grid><TextBox x:Name="ModSearch" AutomationProperties.Name="Search community mods" ToolTip="Search by mod name or author" TextChanged="SearchMods" MinWidth="220"/><TextBlock Text="Search by name or author" Foreground="#7F96A8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ModSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
                    <TextBlock x:Name="RegistrySummary" Grid.Row="1" Foreground="#A9BBC8" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <Grid Grid.Row="2"><Border Background="#19252F" CornerRadius="10" ClipToBounds="True"><DataGrid x:Name="RegistryGrid" RowDetailsVisibilityMode="VisibleWhenSelected"><DataGrid.RowDetailsTemplate><DataTemplate><TextBlock Text="{Binding ReleaseError}" TextWrapping="Wrap" Foreground="#F2D39B" Margin="10"/></DataTemplate></DataGrid.RowDetailsTemplate><DataGrid.Columns>
                        <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="1.1*"/><DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="1*"/><DataGridTemplateColumn Header="Version" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" AutomationProperties.Name="Select mod version" MinWidth="130"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tested game" Binding="{Binding Compatibility}" Width="1.5*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Action}" IsEnabled="{Binding CanDownload}" Tag="{Binding Mod}" Click="DownloadMod" Padding="12,8" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns></DataGrid></Border><TextBlock x:Name="EmptyRegistry" Visibility="Collapsed" Text="No mods match your search." Foreground="#A9BBC8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                </Grid>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Game installation" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Select the folder containing Schedule I.exe." Foreground="#A9BBC8" Margin="0,6,0,14"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Choose folder" Click="ChooseGame" Margin="10,0,0,0"/><TextBox x:Name="GamePath" AutomationProperties.Name="Game folder"/></DockPanel><TextBlock x:Name="GameSummary" Margin="0,10,0,14" Foreground="#83DDBE" TextWrapping="Wrap"/>
                        <WrapPanel><Button Content="Save and check" Click="SaveAndDetect"/><Button Content="Open game folder" Click="OpenGame"/></WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Mod library" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Downloaded mods stay here, including the ones you disable." Foreground="#A9BBC8" Margin="0,6,0,14" TextWrapping="Wrap"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Choose folder" Click="ChooseLibrary" Margin="10,0,0,0"/><TextBox x:Name="LibraryPath" AutomationProperties.Name="Mod library folder"/></DockPanel><WrapPanel Margin="0,14,0,0"><Button Content="Save library" Click="SaveAndDetect"/><Button Content="Open library" Click="OpenLibrary"/></WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Requirements" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DependencySummary" Foreground="#A9BBC8" Margin="0,10,0,10" TextWrapping="Wrap"/><TextBlock x:Name="RequirementDetail" Foreground="#A9BBC8" Margin="0,0,0,16" TextWrapping="Wrap"/>
                        <WrapPanel><Button x:Name="SetupButton" Content="Install missing requirements" Click="InstallRequirements" Background="#286B59"/><Button x:Name="CheckRequirementsButton" Content="Check again" Click="RecheckRequirements"/></WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Read setup and game loader logs inside the manager." Foreground="#A9BBC8" Margin="0,6,0,14"/><WrapPanel><Button Content="Open setup log" Click="OpenSetupLog"/><Button Content="Open loader log" Click="OpenLog"/></WrapPanel></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>
            <Border Grid.Row="3" BorderBrush="#2B3A45" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="ACTIVITY" Foreground="#7F96A8" FontSize="10" Margin="0,0,0,6"/><TextBlock x:Name="StatusText" Text="Ready." Foreground="#A9BBC8" TextWrapping="Wrap" MaxHeight="80"/><ProgressBar x:Name="SetupProgressBar" Height="5" Margin="0,8,0,6" Visibility="Collapsed" Foreground="#83DDBE" Background="#213140"/><Button x:Name="CancelSetupButton" Content="Cancel setup" Click="CancelSetup" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
                <Button x:Name="PlayButton" Grid.Column="1" Content="Play Schedule I" Click="Play" Background="#2A8067" FontWeight="SemiBold" FontSize="16" Padding="24,15" Margin="0" VerticalAlignment="Center"/>
            </Grid></Border>
        </Grid>
    </Grid>
</Window>
