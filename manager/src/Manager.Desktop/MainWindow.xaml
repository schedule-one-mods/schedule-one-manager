<Window x:Class="ScheduleI.Manager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule I Mod Manager" Width="1020" Height="790" MinWidth="860" MinHeight="700" Background="#111923" Foreground="#EDF2F7" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D4356"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#3D5063"/><Setter Property="Padding" Value="7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#213140"/><Setter Property="Foreground" Value="#A9BCCC"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="#192633"/><Setter Property="Foreground" Value="#EDF2F7"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2B4256"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10"><StackPanel><TextBlock Text="SCHEDULE I" Foreground="#73D5B5" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Mod Manager" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,4"/><TextBlock Text="Your local library. One place to set up and play." Foreground="#A9BCCC"/></StackPanel><TextBlock x:Name="VersionLabel" Text="PROTOTYPE" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#A9BCCC"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ControlsPanel">
            <Border Background="#192633" CornerRadius="10" Padding="16" Margin="0,0,0,16"><StackPanel>
                <TextBlock Text="Installation &amp; library" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Game folder" Foreground="#A9BCCC" Margin="0,0,0,6"/>
                <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="ChooseGame" Margin="10,0,0,0"/><TextBox x:Name="GamePath" AutomationProperties.Name="Game folder" ToolTip="Folder containing Schedule I.exe"/></DockPanel>
                <TextBlock Text="Mod library folder" Foreground="#A9BCCC" Margin="0,8,0,6"/>
                <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="ChooseLibrary" Margin="10,0,0,0"/><TextBox x:Name="LibraryPath" AutomationProperties.Name="Mod library folder" ToolTip="Packages are kept here; enabled DLLs are copied to the game Mods folder."/></DockPanel>
                <WrapPanel Margin="0,8,0,0"><Button Content="Save &amp; detect" Click="SaveAndDetect"/><Button Content="Open library" Click="OpenLibrary"/><Button Content="Open game folder" Click="OpenGame"/></WrapPanel>
                <TextBlock x:Name="GameSummary" Text="Select your game folder to get started." Foreground="#73D5B5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="DependencySummary" Foreground="#A9BCCC" Margin="0,5,0,8" TextWrapping="Wrap"/>
                <WrapPanel><Button x:Name="LoaderButton" Content="Install MelonLoader 0.7.3" Click="InstallLoader"/><Button x:Name="RuntimeButton" Content="Install .NET 6 Desktop (x64)" Click="InstallRuntime"/></WrapPanel>
            </StackPanel></Border>
            <Border Background="#192633" CornerRadius="10" Padding="16">
                <TabControl x:Name="ModTabs" Background="#192633" BorderThickness="0" Foreground="#EDF2F7">
                    <TabControl.Resources>
                        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A9BCCC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="#192633" Padding="14,9" Margin="0,0,8,8" CornerRadius="6"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="TabSurface" Property="Background" Value="#2D4356"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                    </TabControl.Resources>
                    <TabItem Header="Available mods"><StackPanel>
                        <DockPanel Margin="0,0,0,8"><Button x:Name="RegistryRefreshButton" DockPanel.Dock="Right" Content="Refresh registry" Click="RefreshRegistry" Margin="10,0,0,0"/><TextBlock x:Name="RegistrySummary" Text="Fetching the community registry..." Foreground="#A9BCCC" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
                        <DataGrid x:Name="RegistryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="#192633" BorderThickness="0" MinHeight="90" MaxHeight="230" SelectionMode="Single" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="1.1*"/>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="0.8*"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="75"/>
                                <DataGridTextColumn Header="Tested game" Binding="{Binding Compatibility}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Action}" IsEnabled="{Binding CanDownload}" Tag="{Binding Mod}" Click="DownloadMod" Padding="12,7" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel></TabItem>
                    <TabItem Header="Installed mods"><StackPanel>
                        <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Refresh library" Click="Refresh" Margin="10,0,0,0"/><TextBlock x:Name="LibrarySummary" Foreground="#A9BCCC" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                <DataGrid x:Name="ModGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="#192633" BorderThickness="0" MinHeight="90" MaxHeight="230" SelectionMode="Single" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="1.2*"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80"/>
                        <DataGridTextColumn Header="Status / compatibility" Binding="{Binding Status}" Width="2.8*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Action}" IsEnabled="{Binding CanToggle}" Tag="{Binding Package}" Click="ToggleMod" Padding="12,7" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                    </StackPanel></TabItem>
                </TabControl>
            </Border>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" Foreground="#A9BCCC"/><Button Content="Open loader log" Click="OpenLog" HorizontalAlignment="Left" Padding="0,6" Background="Transparent" Foreground="#73D5B5"/></StackPanel><Button x:Name="PlayButton" Grid.Column="1" Content="Play Schedule I" Background="#258466" FontWeight="SemiBold" FontSize="16" Padding="28,14" Margin="0" VerticalAlignment="Center" Click="Play"/></Grid>
    </Grid>
</Window>
